+-- A prize is selected and saved by the server before the animation starts.
+-- Delivery is requested only after the five-second hold and flight to bags.
+function BattlePass_OnSpinResult(sender, args)
+    if not args then return end
+    local level, item, token = tonumber(args[1]), tonumber(args[2]), args[3]
+    if not level or level~=math.floor(level) or level<4 or level%4~=0 or
+       type(token)~='string' or not token:match('^%d+$') or #token>20 then return end
+    local accepted=BattlePassSpin.Play(item,token,function()
+        SendClientRequest(CSMHConfig.Prefix,4,level,token)
+    end)
+    if accepted and BattlePassFrame then BattlePassFrame:Hide() end
+end
+local spinQueueNext=false
+function BattlePass_OnSpinQueue(sender,args)
+    spinQueueNext=args and args[1]==true or false
+end
+local spinQueueFrame=CreateFrame('Frame')
+spinQueueFrame:SetScript('OnUpdate',function()
+    if spinQueueNext and not BattlePassSpin.IsBusy() then
+        spinQueueNext=false
+        SendClientRequest(CSMHConfig.Prefix,3,'spin-v1')
+    end
+end)
